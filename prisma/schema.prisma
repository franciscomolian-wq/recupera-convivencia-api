// Esquema de datos — Recupera Convivencia
// Portable: SQLite en desarrollo/local, PostgreSQL en producción (Railway).
// -> Para producción, cambiar el provider de "sqlite" a "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Establishment {
  id           String   @id @default(cuid())
  name         String
  comuna       String?
  type         String   @default("basica") // parvulo | basica | media | adultos
  sostenedor   String?
  students     Int      @default(0)
  ufPerStudent Float    @default(0.05)
  paidUF       Float    @default(0)
  cumplimiento Int      @default(100)
  createdAt    DateTime @default(now())

  users       User[]
  cases       Case[]
  studentList Student[]
  payments    Payment[]
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  role            String   @default("docente") // superadmin | coordinador | director | ...
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId String?
  createdAt       DateTime @default(now())
}

model Student {
  id              String   @id @default(cuid())
  name            String
  curso           String?
  nivel           String?
  apoderadoNombre String?
  apoderadoEmail  String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId String?
  createdAt       DateTime @default(now())

  cases        Case[]
  entrevistas  Entrevista[]
  citaciones   Citacion[]
  compromisos  Compromiso[]
  medidas      Medida[]
}

model Case {
  id             String   @id @default(cuid())
  code           String   @unique
  typeKey        String
  studentLabel   String
  level          String?
  relato         String?
  curso          String?
  fechaHecho     String?
  hora           String?
  lugar          String?
  testigos       String?
  adultosRef     String?
  currentStepIdx Int      @default(0)
  autoEmails     Boolean  @default(false)
  closed         Boolean  @default(false)
  closedAt       DateTime?
  closeSummary   String?
  student        Student? @relation(fields: [studentId], references: [id])
  studentId      String?
  establishment  Establishment? @relation(fields: [establishmentId], references: [id])
  establishmentId String?
  createdAt      DateTime @default(now())

  steps       Step[]
  evidence    Evidence[]
  derivations Derivation[]
  emails      EmailLog[]
}

model Step {
  id     String   @id @default(cuid())
  case   Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String
  order  Int
  title  String
  role   String?
  basis  String?
  due    DateTime?
  done   Boolean  @default(false)
}

model Evidence {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  stepOrder Int?
  type      String
  name      String
  url       String?
  createdAt DateTime @default(now())
}

model Derivation {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  label     String
  email     String
  createdAt DateTime @default(now())
}

model EmailLog {
  id      String   @id @default(cuid())
  case    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId  String
  to      String
  subject String
  at      DateTime @default(now())
}

model Entrevista {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  fecha     String?
  con       String?
  resumen   String?
  foto      String?
  createdAt DateTime @default(now())
}

model Citacion {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  fecha     String?
  motivo    String?
  estado    String   @default("Asiste")
  excusa    String?
  createdAt DateTime @default(now())
}

model Compromiso {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  texto     String
  cumplido  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Medida {
  id          String   @id @default(cuid())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String
  tipo        String   @default("formativa")
  descripcion String
  fecha       String?
  createdAt   DateTime @default(now())
}

model Institution {
  id    String  @id @default(cuid())
  label String
  type  String?
  email String?
}

model Payment {
  id              String   @id @default(cuid())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  establishmentId String
  periodo         String
  totalUF         Float
  paidUF          Float    @default(0)
  status          String   @default("adeudado")
  at              DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  from            String
  title           String
  body            String?
  establishmentId String?
  read            Boolean  @default(false)
  at              DateTime @default(now())
}
