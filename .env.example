# Copia este archivo a ".env" y completa los valores.

# Cadena de conexión de PostgreSQL.
# En Railway: se genera sola al agregar el plugin PostgreSQL (variable DATABASE_URL).
DATABASE_URL="postgresql://usuario:password@host:5432/basedatos"

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Puerto (Railway lo inyecta automáticamente; en local usa 4000).
PORT=4000

# Orígenes permitidos para CORS (separados por coma).
CORS_ORIGIN="http://localhost:5174,https://recupera-convivencia.netlify.app"
